# Le « portier » devant le serveur du jeu :
# - une visite web normale (vérifications de Render, navigateur) reçoit « serveur OK » ;
# - une connexion de joueur (WebSocket) est transmise au serveur Godot, qui écoute en interne sur le port 7777.
map $http_upgrade $connection_upgrade {
	default upgrade;
	''      close;
}

server {
	listen __PORT__;

	location / {
		default_type text/plain;
		if ($http_upgrade = "") {
			return 200 "Royaume en Furie : serveur OK\n";
		}
		proxy_pass http://127.0.0.1:7777;
		proxy_http_version 1.1;
		proxy_set_header Upgrade $http_upgrade;
		proxy_set_header Connection $connection_upgrade;
		proxy_set_header Host $host;
		# Une partie peut durer longtemps : on ne coupe pas les connexions des joueurs
		proxy_read_timeout 3600s;
		proxy_send_timeout 3600s;
	}
}
